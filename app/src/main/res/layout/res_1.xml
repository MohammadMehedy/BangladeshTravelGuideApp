<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/adapter1"
        android:layout_width="400dp"
        android:layout_height="200dp"

        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ocean_kitchen" >

    </ImageView>



    <ImageView
        android:id="@+id/adapter2"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:layout_marginTop="35dp"

        android:layout_below="@+id/adapter1"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/palongki_inani">

    </ImageView>



    <ImageView
        android:id="@+id/adapter3"
        android:layout_width="400dp"
        android:layout_height="200dp"

        android:layout_marginTop="35dp"
        android:layout_below="@+id/adapter2"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sea_mount_beach_cafe" >

    </ImageView>



</RelativeLayout>