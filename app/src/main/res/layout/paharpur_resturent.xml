<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/adapter23"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/green_prairie_restaurant">
    </ImageView>


    <ImageView
        android:id="@+id/adapter24"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:layout_marginTop="35dp"

        android:layout_below="@+id/adapter23"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/kalapata_rstaurant">
    </ImageView>



    <ImageView
        android:id="@+id/adapter25"
        android:layout_width="400dp"
        android:layout_height="200dp"

        android:layout_marginTop="35dp"
        android:layout_below="@+id/adapter24"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chefs_table_courtside" >
    </ImageView>


</RelativeLayout>